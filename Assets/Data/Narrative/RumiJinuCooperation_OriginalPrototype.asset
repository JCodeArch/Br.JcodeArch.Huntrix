  lines:
  - speaker: "Jinu"
    portuguese: "Existe outro caminho. Eu posso abrir passagem."
    english: "There is another way. I can open a path."
    portraitColor: {r: 0.65, g: 0.35, b: 0.9, a: 1}
    voice: {fileID: 0}
  - speaker: "Rumi"
    portuguese: "Então fazemos isso juntos, sem deixar ninguém para trás."
    english: "Then we do this together, leaving no one behind."
    portraitColor: {r: 0.65, g: 0.35, b: 0.9, a: 1}
    voice: {fileID: 0}
